# Object-storage credentials for database backups AND WAL shipping.
#
#   cp deploy/backup.env.sample deploy/backup.env   # then fill in and keep out of git
#
# deploy.sh reads this to build each <site>-backup Secret, which feeds three
# consumers: the app pod (WAL shipping + cold-start restore), the hourly backup
# CronJob, and the manual-recovery escape hatch in the README.
#
# For a site that needs its own bucket or region, add deploy/backup.<site>.env
# with the same keys — a per-site file wins over this shared one.

# Linode Object Storage endpoint for the bucket's region, WITHOUT a scheme.
OBJ_ENDPOINT=us-east-1.linodeobjects.com

# MUST match the bucket's actual region. Both S3 clients (resource/dbbackup and
# db/replicate) fall back to us-east-1 when this is blank, and a wrong region
# fails SigV4 signing in the quietest possible way: the site keeps serving, the
# error only lands in the log, and backups plus WAL shipping simply stop. This
# is why deploy.sh refuses to run without it.
OBJ_REGION=us-east-1

# One bucket for all sites; each site is namespaced under its BACKUP_PREFIX
# (set per-site in the Deployment). Snapshot keys and WAL keys are disjoint by
# shape, so the two tiers can never prune each other's objects.
OBJ_BUCKET=church-backups

OBJ_ACCESS_KEY=
OBJ_SECRET_KEY=

# BACKUP_TOKEN is deliberately absent: deploy.sh reuses the token already in
# the cluster, or mints one with `openssl rand -hex 32` on first deploy.
# Rotating it out from under a running site would break the backup CronJob's
# next call. To read the live one:
#   kubectl -n churches get secret ccswm-backup \
#     -o jsonpath='{.data.BACKUP_TOKEN}' | base64 -d
